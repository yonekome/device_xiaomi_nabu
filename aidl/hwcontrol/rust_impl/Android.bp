rust_binary {
    name: "custom.hardware.hwcontrol-service",
    init_rc: ["custom.hardware.hwcontrol.rc"],
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libbinder_rs",
        "liblog_rust",
        "liblogger",
        "custom.hardware.hwcontrol-V2-rust",
    ],
}

prebuilt_etc {
    name: "custom.hardware.hwcontrol.vintf",
    src: "custom.hardware.hwcontrol.xml",
    sub_dir: "vintf/manifest",
    filename: "custom.hardware.hwcontrol.xml",
}
